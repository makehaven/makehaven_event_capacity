      'type' => 'integer',
      'label' => 'Event Capacity',
      'description' => 'Total capacity of the event.',
      'formatter' => [
        'type' => 'number_integer',
        'settings' => [],
      ],
    ],
    'field_civi_event_registered' => [
      'type' => 'integer',
      'label' => 'Registered Count',
      'description' => 'Number of registered participants.',
      'formatter' => [
        'type' => 'number_integer',
        'settings' => [],
      ],
    ],
    'field_civi_event_remaining' => [
      'type' => 'integer',
      'label' => 'Remaining Slots',
      'description' => 'Number of remaining slots.',
      'formatter' => [
        'type' => 'number_integer',
        'settings' => [],
      ],
    ],
    'field_civi_event_full_pct' => [
      'type' => 'decimal',
      'label' => 'Percent Full',
      'description' => 'Percentage of capacity filled.',
      'settings' => [
        'precision' => 5,
        'scale' => 2,
      ],
      'field_settings' => [
        'suffix' => '%',
      ],
      'formatter' => [
        'type' => 'number_decimal',
        'settings' => [
          'prefix_suffix' => TRUE,
        ],
      ],
    ],
    'field_me_marketing_status' => [
      'type' => 'list_string',
      'label' => 'Marketing Status',
      'description' => 'Current marketing status based on capacity.',
      'settings' => [
        'allowed_values' => [
          'normal' => 'Normal',
          'early_bird' => 'Early Bird',
          'flash_sale' => 'Flash Sale',
        ],
      ],
      'formatter' => [
        'type' => 'makehaven_event_marketing_message',
        'settings' => [],
      ],
    ],
    'field_me_marketing_discount' => [
      'type' => 'integer',
      'label' => 'Marketing Discount (%)',
      'description' => 'Active discount percentage.',
      'formatter' => [
        'type' => 'number_integer',
        'settings' => [],
      ],
    ],
    'field_me_low_cap_notified' => [
      'type' => 'boolean',
      'label' => 'Low Capacity Notified',
      'description' => 'Flag if staff has been notified.',
      'formatter' => [
        'type' => 'boolean',
        'settings' => [],
      ],
